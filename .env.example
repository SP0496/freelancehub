# Database Credentials
MYSQL_ROOT_PASSWORD=YourSecureRootDbPassword123!
USER_DB_PASSWORD=YourSecureUserDbPassword123!
MARKETPLACE_DB_PASSWORD=YourSecureMarketDbPassword123!

# Keycloak Identity Credentials
KEYCLOAK_ADMIN_PASSWORD=YourSecureKeycloakAdminPassword123!

# AWS / Cloud Public Hostname (Set this to your EC2 Public IP or Custom Domain):
# Example with Public IP: http://3.85.120.45:8180
# Example with Custom Domain: https://auth.yourdomain.com:8180 or https://auth.yourdomain.com
KEYCLOAK_HOSTNAME=http://<YOUR_EC2_PUBLIC_IP>:8180
